---
import type { Lang } from "../i18n/translations";
import { t } from "../i18n/translations";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const skills = [
  "Java",
  "Javascript",
  "Typescript",
  "Python",
  "C#",
  "Docker",
  "Kubernetes",
  "MySQL",
  "Postgres",
  "MongoDB",
  "Redis",
  "Git",
  "Cisco IOS/NX-OS",
  "BGP / OSPF",
  "SD-WAN",
  "Firewall & VPN",
  "Proxmox",
  "Linux",
  "Ansible",
  "Wireshark",
];
---

<section id="about" class="px-6 py-24 lg:py-32">
  <div class="mx-auto max-w-5xl">
    <div class="mb-16">
      <p
        class="mb-2 text-sm font-medium tracking-widest text-[var(--color-accent)] uppercase"
      >
        {t(lang, "about.label")}
      </p>
      <h2 class="text-3xl font-bold tracking-tight theme-text sm:text-4xl">
        {t(lang, "about.title")}
      </h2>
    </div>

    <div class="grid gap-16 lg:grid-cols-2 lg:gap-20">
      <!-- Bio -->
      <div>
        <p class="mb-5 leading-relaxed theme-text-secondary">
          {t(lang, "about.bio1")}
        </p>
        <p class="leading-relaxed theme-text-secondary">
          {t(lang, "about.bio2")}
        </p>
      </div>

      <!-- Skills -->
      <div>
        <h3
          class="mb-6 text-sm font-semibold tracking-widest theme-text-muted uppercase"
        >
          {t(lang, "about.skills_label")}
        </h3>
        <div class="flex flex-wrap gap-2.5">
          {
            skills.map((skill) => (
              <span class="rounded-lg border theme-border bg-[var(--bg-card)] px-3.5 py-1.5 text-sm font-medium theme-text-secondary transition-all duration-300 hover:border-[var(--color-accent)]/40 hover:theme-text">
                {skill}
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
