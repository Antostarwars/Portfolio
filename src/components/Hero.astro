---

---

<section
  id="hero"
  class="relative flex min-h-screen items-center justify-center px-6"
>
  <!-- Subtle gradient orb -->
  <div
    class="pointer-events-none absolute top-1/4 left-1/2 h-[500px] w-[500px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[var(--color-accent)]/5 blur-[120px]"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-3xl text-center">
    <p
      class="mb-4 text-sm font-medium tracking-widest text-[var(--color-accent)] uppercase"
    >
      Full-Stack Developer
    </p>
    <h1
      class="mb-6 text-5xl leading-tight font-bold tracking-tight text-zinc-100 sm:text-6xl lg:text-7xl"
    >
      Hi, I'm <span class="text-[var(--color-accent)]">Antostarwars</span>
    </h1>
    <p class="mx-auto mb-10 max-w-xl text-lg leading-relaxed text-zinc-400">
      I craft performant, accessible web applications with clean code and
      thoughtful design. Turning complex ideas into elegant digital experiences.
    </p>
    <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a
        href="#contact"
        class="inline-flex items-center gap-2 rounded-xl bg-[var(--color-accent)] px-7 py-3 text-sm font-semibold text-white shadow-lg shadow-[var(--color-accent)]/20 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-xl hover:shadow-[var(--color-accent)]/30"
      >
        Get in Touch
        <svg
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3"></path>
        </svg>
      </a>
      <a
        href="#projects"
        class="inline-flex items-center gap-2 rounded-xl border border-zinc-700 px-7 py-3 text-sm font-semibold text-zinc-300 transition-all duration-300 hover:-translate-y-0.5 hover:border-zinc-500 hover:text-zinc-100"
      >
        View Work
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2" aria-hidden="true">
    <div class="h-8 w-5 rounded-full border-2 border-zinc-700 p-1">
      <div class="mx-auto h-1.5 w-1 animate-bounce rounded-full bg-zinc-500">
      </div>
    </div>
  </div>
</section>
